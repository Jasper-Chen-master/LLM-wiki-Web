# ===== OpenRouter API 配置模板 =====
# 使用方法：把本文件复制为 .env，然后在 .env 里填入你的 key：
#   Copy-Item .env.example .env
# 获取 API key：https://openrouter.ai/keys → 注册登录 → Create Key

# 必填：你的 OpenRouter API key
OPENROUTER_API_KEY=sk-or-your-key-here

# 以下为可选项，不填则默认使用 OpenRouter 的 GLM 5.3 Flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=z-ai/glm-5.3-flash
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_SITE_NAME=LLM Wiki
#
# 推理型模型(GLM系列)专用：思考token单独限额(默认2000)，防止思考耗尽输出预算导致空结果
# OPENROUTER_REASONING_MAX_TOKENS=2000
# 流式接收的空闲超时秒数上限(默认120s，每收到数据自动重置)；总时长硬上限默认900s
# OPENROUTER_TIMEOUT_MS=120000
# OPENROUTER_MAX_TIMEOUT_MS=900000

# Wiki 构建并发上限。默认规划阶段 2、筛选/抽取/分类阶段 3；建议仅在确认 API 配额后调高，最大 8。
# WIKI_PLANNING_CONCURRENCY=2
# WIKI_PIPELINE_CONCURRENCY=3
