# ===== DeepSeek API 配置模板 =====
# 使用方法：把本文件复制为 .env，然后在 .env 里填入你的 key：
#   Copy-Item .env.example .env
# 获取 API key：https://platform.deepseek.com → 注册登录 → API Keys → 创建新 key（sk- 开头）

# 必填：你的 DeepSeek API key
DEEPSEEK_API_KEY=sk-your-key-here

# 以下为可选项，不填则默认使用 DeepSeek 官方服务
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Wiki 构建并发上限。默认规划阶段 2、筛选/抽取/分类阶段 3；建议仅在确认 API 配额后调高，最大 8。
# WIKI_PLANNING_CONCURRENCY=2
# WIKI_PIPELINE_CONCURRENCY=3
